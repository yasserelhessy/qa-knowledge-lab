{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "status",
    "sources",
    "mode",
    "retrieval_score"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "answered",
        "refused"
      ]
    },
    "mode": {
      "enum": [
        "demo",
        "openai"
      ]
    },
    "retrieval_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "excerpt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        }
      }
    }
  }
}
